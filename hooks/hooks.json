{
  "description": "Optional Codex transport for the retained studio runtime. Requires initialization and hook trust; behavioral validation pending.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT}/skills/game-studios/scripts/studio.py\" hook",
            "command_windows": "python \"${PLUGIN_ROOT}/skills/game-studios/scripts/studio.py\" hook",
            "timeout": 120
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "^(Bash|exec_command|PowerShell|apply_patch|Read|Edit|Write|mcp__.*read_file)$",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT}/skills/game-studios/scripts/studio.py\" hook",
            "command_windows": "python \"${PLUGIN_ROOT}/skills/game-studios/scripts/studio.py\" hook",
            "timeout": 120
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "^(apply_patch|Edit|Write)$",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT}/skills/game-studios/scripts/studio.py\" hook",
            "command_windows": "python \"${PLUGIN_ROOT}/skills/game-studios/scripts/studio.py\" hook",
            "timeout": 120
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT}/skills/game-studios/scripts/studio.py\" hook",
            "command_windows": "python \"${PLUGIN_ROOT}/skills/game-studios/scripts/studio.py\" hook",
            "timeout": 120
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT}/skills/game-studios/scripts/studio.py\" hook",
            "command_windows": "python \"${PLUGIN_ROOT}/skills/game-studios/scripts/studio.py\" hook",
            "timeout": 120
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT}/skills/game-studios/scripts/studio.py\" hook",
            "command_windows": "python \"${PLUGIN_ROOT}/skills/game-studios/scripts/studio.py\" hook",
            "timeout": 120
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT}/skills/game-studios/scripts/studio.py\" hook",
            "command_windows": "python \"${PLUGIN_ROOT}/skills/game-studios/scripts/studio.py\" hook",
            "timeout": 120
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "hooks": [
          {
            "command": "python3 \"${PLUGIN_ROOT}/skills/game-studios/scripts/studio.py\" hook",
            "command_windows": "python \"${PLUGIN_ROOT}/skills/game-studios/scripts/studio.py\" hook",
            "timeout": 20,
            "type": "command"
          }
        ]
      }
    ]
  }
}
